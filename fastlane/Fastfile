# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:android)

platform :android do

   #################### Lanes ####################

   desc "Upload new INTERNAL release"
   lane :internal_release do
      begin
         gradle(task: "clean assembleDebug")
         changelog = changelog_from_git_commits(
            pretty: "• %s",
            merge_commit_filtering: "exclude_merges",
            commits_count: 10
         )
         upload_firebase(changelog, true)
         send_slack_success(changelog)
      rescue => error
         send_slack_error(error)
         raise error
      end
   end


   desc "Upload new EXTERNAL release"
   lane :external_release do
      begin
         gradle(task: "clean assembleRelease")
         changelog = changelog_from_git_commits(
            pretty: "• %s",
            merge_commit_filtering: "exclude_merges",
            commits_count: 10
         )
         upload_firebase(changelog, false)
         send_slack_success(changelog)
      rescue => error
        send_slack_error(error)
        raise error
      end
   end

   #################### Helper functions ####################

   # Plugin to upload build to firebase app distribution
   # Latest commit is used in release note
   # groups_file is a text file containing your group of testers.
   def upload_firebase(changelog, isInternal)
      apk_path = isInternal ? "app/build/outputs/apk/debug/app-debug.apk" : "app/build/outputs/apk/release/app-release.apk"

      firebase_app_distribution(
         app: ENV["FIREBASE_APP_ID"],
         apk_path: apk_path,
         release_notes: "What's included? \n" + changelog,
         groups_file: "fastlane/groups.txt",
         service_credentials_file: "fastlane/firebase_credentials.json"
      )
   end

   # Sends a Slack success message after a successful build or deployment.
   def send_slack_success(changelog)
      build_number = ENV["BUILD_NUMBER"] || "Unknown"

      slack(
         message: ":rocket: Build #{build_number} is up! :rocket:",
         slack_url: ENV["SLACK_URL"],
         default_payloads: [:git_branch, :git_author],
         attachment_properties: {
            fields: [
               {
                  title: "CHANGELOG",
                  value: changelog,
                  short: false
               }
            ]
         }
      )
   end

   # Sends a Slack error message when a build or deployment fails.
   def send_slack_error(exception)
      slack(
         message: "Oops! Something went wrong. ❌",
         default_payloads: [:git_branch, :git_author],
         slack_url: ENV["SLACK_URL"],
         success: false,
         attachment_properties: {
            fields: [
               {
                  title: "Error Message",
                  value: exception,
                  short: false
               }
            ]
         }
      )
   end
end
